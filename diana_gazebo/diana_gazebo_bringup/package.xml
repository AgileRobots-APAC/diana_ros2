<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diana_gazebo_bringup</name>
  <version>2.7.0</version>
  <description>Launch files, worlds and robot descriptions for the diana_gazebo simulation</description>
  <maintainer email="service.apac@agile-robots.com">Agile Robots SE</maintainer>
  <license>Apache 2.0</license>

  <depend>ros_gz</depend>
  <depend>sdformat_urdf</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>diana_description</depend>
  <depend>gz_ros2_control</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>diana_gazebo_hardware</exec_depend>
  <exec_depend>diana_hardware</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>diana_example_controllers</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
